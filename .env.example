# ── Copy to .env and fill in ──────────────────────────────────────────────
# docker compose reads this file automatically.

# General
TZ=America/Chicago

# Weather (Open-Meteo, no API key). Any "City, Region/Country" string.
WEATHER_LOCATION=Davenport, Iowa, United States
WEATHER_UNITS=imperial            # metric | imperial

# CasaOS — used by the "Services" monitor and "Quick Access" bookmarks.
# Use the Pi's LAN IP, not localhost, so it resolves from the kiosk too.
CASAOS_URL=http://192.168.1.10

# Google Calendar embed shown in the big center panel. <CAL_ID> is usually your
# Gmail address, URL-encoded (you%40gmail.com). Renders once the display's
# Chromium is signed into Google — run kiosk/google-login.sh. See README.
GCAL_EMBED_URL=https://calendar.google.com/calendar/embed?src=you%40gmail.com&ctz=America%2FChicago&mode=WEEK&showTitle=0&showPrint=0&showTz=0

# CPU temperature sensor name for the server-stats widget.
# Find it with:  cat /sys/class/thermal/thermal_zone*/type
# On most Raspberry Pi 4/5 it is "cpu_thermal" (sometimes blank works).
CPU_TEMP_SENSOR=cpu_thermal

# ── Containers widget ─────────────────────────────────────────────────────
# The Containers widget lists Docker containers (sidecar reads the mounted
# docker.sock) and each row has a "rerun" button that restarts that container.
# The button fires from the kiosk browser, so this must be the sidecar's
# address as that browser sees it — the Pi's LAN IP, like CASAOS_URL.
SIDECAR_PUBLIC_URL=http://192.168.1.10:3000
SIDECAR_PORT=3000

# ── Calendar feed ─────────────────────────────────────────────────────────
# The sidecar reads Calendar through the Google API with the OAuth token below
# (mint it with the calendar.readonly scope — see "Gmail setup"). Which calendar:
GOOGLE_CALENDAR_ID=primary
GCAL_LOOKAHEAD_DAYS=14
# Legacy: a secret iCal URL, used only when no OAuth token is set. From Calendar
# settings → "Integrate calendar" → "Secret address in iCal format".
GOOGLE_ICAL_URL=

# ── Google OAuth (Gmail inbox + Calendar) ─────────────────────────────────
# See README "Gmail setup". The refresh token needs both scopes:
#   gmail.readonly  calendar.readonly
# Leave blank to disable the Inbox and Calendar widgets.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_QUERY=is:unread in:inbox
