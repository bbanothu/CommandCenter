# ── Copy to .env and fill in ──────────────────────────────────────────────
# docker compose reads this file automatically.

# General
TZ=America/Chicago

# Weather (Open-Meteo, no API key). Any "City, Region/Country" string.
WEATHER_LOCATION=Davenport, Iowa, United States
WEATHER_UNITS=imperial            # metric | imperial

# CasaOS — used by the "Services" monitor and "Quick Access" bookmarks.
# Use the Pi's LAN IP, not localhost, so it resolves from the kiosk too.
CASAOS_URL=http://192.168.1.10

# Google Calendar embed shown in the big center panel. <CAL_ID> is usually your
# Gmail address, URL-encoded (you%40gmail.com). Renders once the display's
# Chromium is signed into Google — run kiosk/google-login.sh. See README.
GCAL_EMBED_URL=https://calendar.google.com/calendar/embed?src=you%40gmail.com&ctz=America%2FChicago&mode=MONTH&showTitle=0&showPrint=0&showTz=0

# CPU temperature sensor name for the server-stats widget.
# Find it with:  cat /sys/class/thermal/thermal_zone*/type
# On most Raspberry Pi 4/5 it is "cpu_thermal" (sometimes blank works).
CPU_TEMP_SENSOR=cpu_thermal

# ── Agenda feed (optional) ────────────────────────────────────────────────
# Only used if you re-add a text "Agenda" widget. Secret iCal URL from
# Calendar settings → "Integrate calendar" → "Secret address in iCal format".
GOOGLE_ICAL_URL=
GCAL_LOOKAHEAD_DAYS=14

# ── Gmail (optional) ──────────────────────────────────────────────────────
# See README "Gmail setup". Leave blank to disable the Inbox widget.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_QUERY=is:unread in:inbox
